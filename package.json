{
  "name": "metaharness",
  "version": "0.0.1",
  "private": true,
  "description": "Run a team of AI agents from different providers, each in its native harness, on one goal.",
  "type": "module",
  "bin": {
    "mh": "./bin/mh.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "mh": "node src/cli.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc && tsc -p ui",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "web-tree-sitter": "0.27.1",
    "zod": "4.6.5"
  }
}
